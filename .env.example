# ── AWS ────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── Bedrock ────────────────────────────────────────────────────────────
# Do NOT hardcode a model ID. Discover the global cross-region inference
# profile at deploy time and paste the exact ID you actually see:
#   aws bedrock list-inference-profiles --region ap-south-1
#   aws bedrock list-foundation-models  --region ap-south-1
# Leave empty to force the deterministic template composer fallback.
BEDROCK_INFERENCE_PROFILE_ID=
BEDROCK_ENABLED=false

# ── DynamoDB ───────────────────────────────────────────────────────────
COMPLAINTS_TABLE=MeraWardComplaints
WARDS_TABLE=MeraWardWards

# ── S3 ─────────────────────────────────────────────────────────────────
PHOTOS_BUCKET=meraward-photos-<account-id>
DATA_BUCKET=meraward-data-<account-id>
WARDS_GEOJSON_KEY=wards.geojson
MAX_PHOTO_BYTES=8388608

# ── SQS ────────────────────────────────────────────────────────────────
DRAFT_QUEUE_URL=

# ── SES / delivery ─────────────────────────────────────────────────────
# DEMO_OUTBOX | SES_VERIFIED | SES_LIVE   (SES_LIVE must stay off)
DELIVERY_MODE=DEMO_OUTBOX
SES_SENDER=
SES_DEMO_RECIPIENT=

# ── Frontend ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_BASEMAP_STYLE_URL=
VITE_BASEMAP_API_KEY=
